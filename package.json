    "build": "cross-env NODE_ENV=package npm run build:start",
    "build:start": "webpack --config config/webpack.build.js",
    "dev": "cross-env NODE_ENV=development npm run dev:start",
    "dev:start": "webpack serve --config config/webpack.dev.js --progress --profile --stats-error-details",
    "demo": "cross-env NODE_ENV=production npm run demo:start",
    "demo:start": "webpack serve --config config/webpack.demo.js --progress --profile --stats-error-details",
    "test": "jest --runInBand --no-cache",
    "lint": "npx eslint --no-cache --ext .ts src",
    "pub": "node config/publish.js && npm publish --access=public --tag=latest"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "vue",
    "datatable"
  ],
  "author": "DN WEB",
